# input:Hello World
# output:dlroW olleH
# == Print Hello World over UART ==
# SAVE DS
SUBI SP 1
STOREIN SP DS 1
# Save letters for "Hello World"
LOADI ACC 1
INT 0
# H
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# e
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# l
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# l
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# o
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# " "
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# W
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# o
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# r
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# l
SUBI SP 1
STOREIN SP ACC 1
LOADI ACC 1
INT 0
# d
SUBI SP 1
STOREIN SP ACC 1
# Print over uart
LOADIN SP ACC 1
ADDI SP 1
# d
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# l
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# r
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# o
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# W
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# " "
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# o
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# l
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# l
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# e
MOVE ACC IN1
LOADI ACC 0
INT 0
LOADIN SP ACC 1
ADDI SP 1
# H
MOVE ACC IN1
LOADI ACC 0
INT 0
# RESTORE DS
LOADIN SP DS 1
ADDI SP 1
JUMP 0
