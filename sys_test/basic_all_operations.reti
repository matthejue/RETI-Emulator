# output:ABCDEFGHIJ
# Compute Immediate
LOADI ACC 10
ADDI ACC 2
SUBI ACC 2
MULTI ACC 3
DIVI ACC 5
MODI ACC 4
OPLUSI ACC 3
ORI ACC 64
ANDI ACC 127
MOVE ACC IN1
LOADI ACC 0
INT 0

# Compute Register
LOADI ACC 10
LOADI IN1 2
ADD ACC IN1
SUB ACC IN1
MULT ACC IN1
DIV ACC IN1
MOD ACC IN1
OPLUS ACC IN1
OR ACC IN1
LOADI IN2 3
AND ACC IN2
ADDI ACC 64
MOVE ACC IN1
LOADI ACC 0
INT 0

# Compute Memory
LOADI IN1 2
STORE IN1 0
LOADI ACC 10
ADD ACC 0
SUB ACC 0
MULT ACC 0
DIV ACC 0
MOD ACC 0
OPLUS ACC 0
OR ACC 0
AND ACC 0
ADDI ACC 65
MOVE ACC IN1
LOADI ACC 0
INT 0

# Load, Store, Storein, Loadin, Move, and Nop
LOADI ACC 68
STORE ACC 1
LOADI ACC 0
LOAD ACC 1
MOVE DS BAF
STOREIN BAF ACC 2
LOADI ACC 0
LOADIN BAF ACC 2
NOP
MOVE ACC IN1
LOADI ACC 0
INT 0

# Tests JUMP> for taken and not-taken conditions
LOADI IN2 69
LOADI ACC 1
JUMP> 2
LOADI IN2 88
LOADI ACC 0
JUMP> 2
JUMP 2
LOADI IN2 88
MOVE IN2 IN1
LOADI ACC 0
INT 0

# Tests JUMP== for taken and not-taken conditions
LOADI IN2 70
LOADI ACC 0
JUMP== 2
LOADI IN2 88
LOADI ACC 1
JUMP== 2
JUMP 2
LOADI IN2 88
MOVE IN2 IN1
LOADI ACC 0
INT 0

# Tests JUMP>= for taken and not-taken conditions
LOADI IN2 71
LOADI ACC 0
JUMP>= 2
LOADI IN2 88
LOADI ACC -1
JUMP>= 2
JUMP 2
LOADI IN2 88
MOVE IN2 IN1
LOADI ACC 0
INT 0

# Tests JUMP< for taken and not-taken conditions
LOADI IN2 72
LOADI ACC -1
JUMP< 2
LOADI IN2 88
LOADI ACC 0
JUMP< 2
JUMP 2
LOADI IN2 88
MOVE IN2 IN1
LOADI ACC 0
INT 0

# Tests JUMP!= for taken and not-taken conditions
LOADI IN2 73
LOADI ACC 1
JUMP!= 2
LOADI IN2 88
LOADI ACC 0
JUMP!= 2
JUMP 2
LOADI IN2 88
MOVE IN2 IN1
LOADI ACC 0
INT 0

# Tests JUMP<= for taken and not-taken conditions
LOADI IN2 74
LOADI ACC 0
JUMP<= 2
LOADI IN2 88
LOADI ACC 1
JUMP<= 2
JUMP 2
LOADI IN2 88
MOVE IN2 IN1
LOADI ACC 0
INT 0
JUMP 0
