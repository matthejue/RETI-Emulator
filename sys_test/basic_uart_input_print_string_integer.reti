# input:Hello World
# output:dlroW olleH
# == Print Hello World over UART ==
# SAVE DS
SUBI SP 1
STOREIN SP DS 1
# Save letters for "Hello World"
INT 1
# H
SUBI SP 1
STOREIN SP ACC 1
INT 1
# e
SUBI SP 1
STOREIN SP ACC 1
INT 1
# l
SUBI SP 1
STOREIN SP ACC 1
INT 1
# l
SUBI SP 1
STOREIN SP ACC 1
INT 1
# o
SUBI SP 1
STOREIN SP ACC 1
INT 1
# " "
SUBI SP 1
STOREIN SP ACC 1
INT 1
# W
SUBI SP 1
STOREIN SP ACC 1
INT 1
# o
SUBI SP 1
STOREIN SP ACC 1
INT 1
# r
SUBI SP 1
STOREIN SP ACC 1
INT 1
# l
SUBI SP 1
STOREIN SP ACC 1
INT 1
# d
SUBI SP 1
STOREIN SP ACC 1
# Print over uart
LOADIN SP ACC 1
ADDI SP 1
# d
INT 0
LOADIN SP ACC 1
ADDI SP 1
# l
INT 0
LOADIN SP ACC 1
ADDI SP 1
# r
INT 0
LOADIN SP ACC 1
ADDI SP 1
# o
INT 0
LOADIN SP ACC 1
ADDI SP 1
# W
INT 0
LOADIN SP ACC 1
ADDI SP 1
# " "
INT 0
LOADIN SP ACC 1
ADDI SP 1
# o
INT 0
LOADIN SP ACC 1
ADDI SP 1
# l
INT 0
LOADIN SP ACC 1
ADDI SP 1
# l
INT 0
LOADIN SP ACC 1
ADDI SP 1
# e
INT 0
LOADIN SP ACC 1
ADDI SP 1
# H
INT 0
# RESTORE DS
LOADIN SP DS 1
ADDI SP 1
JUMP 0